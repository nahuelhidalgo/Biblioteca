<!DOCTYPE html>
@{
    var cuenta = Microsoft.AspNetCore.Http.SessionExtensions.GetString(Context.Session, Biblioteca.Seguridad.SesionKeys.Cuenta);
    var nombreEmpleado = Microsoft.AspNetCore.Http.SessionExtensions.GetString(Context.Session, Biblioteca.Seguridad.SesionKeys.NombreEmpleado);
    var rol = Microsoft.AspNetCore.Http.SessionExtensions.GetString(Context.Session, Biblioteca.Seguridad.SesionKeys.Rol);
    var estaAutenticado = !string.IsNullOrWhiteSpace(cuenta);
    var identidadVisible = !string.IsNullOrWhiteSpace(nombreEmpleado) ? nombreEmpleado : cuenta;
    var esAdministrador = string.Equals(rol, Biblioteca.Seguridad.RolesSistema.Administrador, StringComparison.OrdinalIgnoreCase);
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Biblioteca.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Biblioteca</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (estaAutenticado)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Prestamos" asp-action="Index">Prestamos</a>
                            </li>
                            @if (esAdministrador)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="MovimientosStock" asp-action="Index">Movimientos</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Libros" asp-action="Index">Libros</a>
                            </li>
                            @if (esAdministrador)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Empleados" asp-action="Index">Empleados</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Clientes" asp-action="Index">Clientes</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (estaAutenticado)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-dark">@identidadVisible (@rol)</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Cuentas" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-link nav-link text-dark">Salir</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Cuentas" asp-action="Login">Ingresar</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Biblioteca - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
