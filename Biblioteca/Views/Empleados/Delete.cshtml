@model Empleado

@{
    ViewData["Title"] = "Eliminar empleado";
}

<h1>Eliminar empleado</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<p>Solo se podra eliminar si no tiene usuario, prestamos ni movimientos asociados.</p>

<dl class="row">
    <dt class="col-sm-3">Empleado</dt>
    <dd class="col-sm-9">@Model.NombreCompleto</dd>
    <dt class="col-sm-3">Usuario</dt>
    <dd class="col-sm-9">@Model.Usuario?.Email</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="IdPersona" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>
