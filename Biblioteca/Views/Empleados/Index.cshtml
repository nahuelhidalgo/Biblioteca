@model IEnumerable<Empleado>

@{
    ViewData["Title"] = "Empleados";
}

<h1>Empleados</h1>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Crear empleado</a>
</p>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>DNI</th>
            <th>Teléfono</th>
            <th>Usuario</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.NombreCompleto</td>
            <td>@item.DNI</td>
            <td>@item.Telefono</td>
            <td>@item.Usuario?.Email</td>
            <td>
                <span class="badge @(item.Activo ? "text-bg-success" : "text-bg-secondary")">
                    @(item.Activo ? "Activo" : "Inactivo")
                </span>
            </td>
            <td class="text-end">
                <div class="table-actions">
                    <a asp-action="Edit" asp-route-id="@item.IdPersona" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.IdPersona" class="btn btn-sm btn-outline-secondary">Detalle</a>
                    @if (item.Activo)
                    {
                        <a asp-action="Delete" asp-route-id="@item.IdPersona" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    }
                    else
                    {
                        <form asp-action="Activar" asp-route-id="@item.IdPersona" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-success">Activar</button>
                        </form>
                    }
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
