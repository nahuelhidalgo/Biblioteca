@model Empleado

@{
    ViewData["Title"] = "Detalle de empleado";
}

<h1>Detalle de empleado</h1>

<dl class="row">
    <dt class="col-sm-3">Legajo</dt>
    <dd class="col-sm-9">@Model.Legajo</dd>
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Apellido, @Model.Nombre</dd>
    <dt class="col-sm-3">DNI</dt>
    <dd class="col-sm-9">@Model.DNI</dd>
    <dt class="col-sm-3">Telefono</dt>
    <dd class="col-sm-9">@Model.Telefono</dd>
    <dt class="col-sm-3">Direccion</dt>
    <dd class="col-sm-9">@Model.Direccion</dd>
    <dt class="col-sm-3">Usuario</dt>
    <dd class="col-sm-9">@Model.Usuario?.Email</dd>
    <dt class="col-sm-3">Prestamos registrados</dt>
    <dd class="col-sm-9">@Model.Prestamos.Count</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Legajo" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>
