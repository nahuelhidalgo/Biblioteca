@model Usuario

@{
    ViewData["Title"] = "Baja de usuario";
}

<h1>Baja de usuario</h1>

<p>Se marcara el usuario como inactivo.</p>

<dl class="row">
    <dt class="col-sm-3">Cuenta</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Empleado</dt>
    <dd class="col-sm-9">@Model.Empleado.Apellido, @Model.Empleado.Nombre</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="IdUsuarioSistema" />
    <button type="submit" class="btn btn-danger">Confirmar baja</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>
