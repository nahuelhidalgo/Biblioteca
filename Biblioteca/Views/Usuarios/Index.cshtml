@model IEnumerable<Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<h1>Usuarios</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear usuario</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Email</th>
            <th>Rol</th>
            <th>Empleado</th>
            <th>Activo</th>
            <th>Ultimo acceso</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Email</td>
            <td>@item.Rol</td>
            <td>@item.Empleado.Apellido, @item.Empleado.Nombre</td>
            <td>@(item.Activo ? "Si" : "No")</td>
            <td>@item.UltimoAcceso?.ToString("dd/MM/yyyy HH:mm")</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@item.IdUsuarioSistema">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.IdUsuarioSistema">Detalle</a> |
                <a asp-action="Delete" asp-route-id="@item.IdUsuarioSistema">Baja</a>
            </td>
        </tr>
}
    </tbody>
</table>
