@model Editorial

@{
    ViewData["Title"] = "Detalle de editorial";
    var esAdministrador = string.Equals(Context.Session.GetString(SesionKeys.Rol), RolesSistema.Administrador, StringComparison.OrdinalIgnoreCase);
}

<h1>Detalle de editorial</h1>

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>
    <dt class="col-sm-3">Descripcion</dt>
    <dd class="col-sm-9">@Model.Descripcion</dd>
    <dt class="col-sm-3">Activo</dt>
    <dd class="col-sm-9">@(Model.Activo ? "Si" : "No")</dd>
    <dt class="col-sm-3">Libros asociados</dt>
    <dd class="col-sm-9">@Model.Libros.Count</dd>
</dl>

@if (esAdministrador)
{
    <a asp-action="Edit" asp-route-id="@Model.IdEditorial" class="btn btn-primary">Editar</a>
}
<a asp-action="Index" class="btn btn-secondary">Volver</a>
