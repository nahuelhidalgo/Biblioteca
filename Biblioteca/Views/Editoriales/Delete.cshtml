@model Editorial

@{
    ViewData["Title"] = "Baja de editorial";
}

<h1>Baja de editorial</h1>

<p>Se marcara la editorial como inactiva.</p>

<dl class="row">
    <dt class="col-sm-3">Editorial</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="IdEditorial" />
    <button type="submit" class="btn btn-danger">Confirmar baja</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>
