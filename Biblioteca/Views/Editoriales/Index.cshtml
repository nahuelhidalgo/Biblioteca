@model IEnumerable<Editorial>

@{
    ViewData["Title"] = "Editoriales";
    var esAdministrador = string.Equals(Context.Session.GetString(SesionKeys.Rol), RolesSistema.Administrador, StringComparison.OrdinalIgnoreCase);
}

<h1>Editoriales</h1>

@if (esAdministrador)
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Crear editorial</a>
    </p>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripcion</th>
            <th>Activo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Nombre</td>
            <td>@item.Descripcion</td>
            <td>@(item.Activo ? "Si" : "No")</td>
            <td class="text-end">
                @if (esAdministrador)
                {
                    <div class="table-actions">
                        <a asp-action="Edit" asp-route-id="@item.IdEditorial" class="btn btn-sm btn-outline-primary">Editar</a>
                        @if (item.Activo)
                        {
                            <a asp-action="Delete" asp-route-id="@item.IdEditorial" class="btn btn-sm btn-outline-danger">Baja</a>
                        }
                        else
                        {
                            <form asp-action="Activar" asp-route-id="@item.IdEditorial" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-success">Activar</button>
                            </form>
                        }
                    </div>
                }
            </td>
        </tr>
}
    </tbody>
</table>
