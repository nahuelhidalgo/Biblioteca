@model PrestamoCreateViewModel

@{
    ViewData["Title"] = "Nuevo prestamo";
}

<h1>Nuevo prestamo</h1>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @for (var i = 0; i < Model.Items.Count; i++)
    {
        <input type="hidden" asp-for="Items[i].IdLibro" />
        <input type="hidden" asp-for="Items[i].ISBN" />
        <input type="hidden" asp-for="Items[i].Titulo" />
        <input type="hidden" asp-for="Items[i].StockDisponible" />
        <input type="hidden" asp-for="Items[i].Cantidad" />
    }

    <div class="mb-3">
        <label asp-for="IdCliente" class="form-label"></label>
        <div class="row g-2">
            <div class="col-md-9">
                <select asp-for="IdCliente" asp-items="ViewBag.Clientes" class="form-select">
                    <option value="">Seleccione un cliente</option>
                </select>
            </div>
            <div class="col-md-3">
                <a asp-controller="Clientes"
                   asp-action="Create"
                   asp-route-returnUrl="@Url.Action("Create", "Prestamos")"
                   class="btn btn-outline-primary w-100">Nuevo cliente</a>
            </div>
        </div>
        <span asp-validation-for="IdCliente" class="text-danger"></span>
    </div>

    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label asp-for="ISBN" class="form-label"></label>
            <select asp-for="ISBN" asp-items="ViewBag.LibrosISBN" class="form-select">
                <option value="">Seleccione un libro</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="Cantidad" class="form-label"></label>
            <input asp-for="Cantidad" type="number" min="1" class="form-control" />
        </div>
        <div class="col-md-3">
            <button type="submit"
                    asp-action="AgregarAlCarrito"
                    formnovalidate
                    class="btn btn-outline-primary w-100 cancel">
                Agregar al prestamo
            </button>
        </div>
    </div>
    <div class="prestamo-validation-line mb-3">
        @Html.ValidationMessage("AgregarLibro", null, new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        <h2 class="h5">Carrito de prestamo</h2>
        @if (Model.Items.Count == 0)
        {
            <p class="text-muted">Todavia no agregaste libros.</p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>ISBN</th>
                        <th>Libro</th>
                        <th>Disponible</th>
                        <th>Cantidad</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
@foreach (var item in Model.Items)
{
                    <tr>
                        <td>@item.ISBN</td>
                        <td>@item.Titulo</td>
                        <td>@item.StockDisponible</td>
                        <td>@item.Cantidad</td>
                        <td class="text-end">
                            <button type="submit"
                                    asp-action="QuitarDelCarrito"
                                    asp-route-idLibro="@item.IdLibro"
                                    formnovalidate
                                    class="btn btn-link p-0 cancel">
                                Quitar
                            </button>
                        </td>
                    </tr>
}
                </tbody>
            </table>
        }
        <span asp-validation-for="Items" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DuracionDias" class="form-label"></label>
        <div class="input-group">
            <input asp-for="DuracionDias" type="number" class="form-control" />
            <span class="input-group-text">días</span>
        </div>
        <span asp-validation-for="DuracionDias" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar prestamo</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
