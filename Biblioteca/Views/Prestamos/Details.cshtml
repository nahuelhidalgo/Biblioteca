@model Prestamo

@{
    ViewData["Title"] = "Detalle de prestamo";
    var tienePendientes = Model.ItemsPrestamo.Any(i => i.FechaDevolucion is null);
    var estaVencido = tienePendientes && Model.FechaEstimadaDevolucion.Date < DateTime.Today;
    var esAdministrador = string.Equals(Context.Session.GetString(SesionKeys.Rol), RolesSistema.Administrador, StringComparison.OrdinalIgnoreCase);
}

<h1>Detalle de prestamo</h1>

<dl class="row">
    <dt class="col-sm-3">Nro.</dt>
    <dd class="col-sm-9">@Model.IdPrestamo</dd>
    <dt class="col-sm-3">Empleado</dt>
    <dd class="col-sm-9">@Model.Empleado.NombreCompleto</dd>
    <dt class="col-sm-3">Fecha de creación</dt>
    <dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Fecha de devolución</dt>
    <dd class="col-sm-9">@Model.FechaEstimadaDevolucion.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Devolución registrada</dt>
    <dd class="col-sm-9">@(Model.FechaDevolucion?.ToString("dd/MM/yyyy") ?? "-")</dd>
    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Model.Estado</dd>
</dl>

@if (estaVencido)
{
    <div class="alert alert-warning">
        Este prestamo esta vencido. La fecha de devolución era @Model.FechaEstimadaDevolucion.ToString("dd/MM/yyyy").
    </div>
}

@if (tienePendientes)
{
    <p>
        <a asp-action="Devolver" asp-route-id="@Model.IdPrestamo" class="btn btn-primary">Registrar devolucion</a>
    </p>
}

<h2>Libros</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Libro</th>
            <th>Estado</th>
            <th>Devuelto el</th>
            <th>Dias retraso</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.ItemsPrestamo)
{
        <tr>
            <td>@item.Libro.Titulo</td>
            <td>@item.EstadoItem</td>
            <td>@item.FechaDevolucion?.ToString("dd/MM/yyyy")</td>
            <td>@item.DiasRetraso</td>
        </tr>
}
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Volver</a>
@if (esAdministrador)
{
    <a asp-action="Baja" asp-route-id="@Model.IdPrestamo" class="btn btn-danger">Dar de baja</a>
}
