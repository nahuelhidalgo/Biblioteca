@model DevolucionPrestamoViewModel

@{
    ViewData["Title"] = "Registrar devolución";
    var prestamoCargado = Model.IdPrestamo > 0 && !string.IsNullOrWhiteSpace(Model.Prestamo);
}

<h1>Registrar devolución</h1>

<form asp-action="Devolver" method="get" class="mb-4">
    <div class="d-flex flex-wrap align-items-start gap-3">
        <div style="min-width: 280px; max-width: 420px; flex: 1 1 320px;">
            <label asp-for="IdPrestamo" class="form-label"></label>
            <input id="IdPrestamo" name="id" type="number" class="form-control" value="@(Model.IdPrestamo > 0 ? Model.IdPrestamo.ToString() : string.Empty)" />
            <span asp-validation-for="IdPrestamo" class="text-danger"></span>
        </div>
        <div class="pt-4">
            <button type="submit" class="btn btn-outline-primary">Buscar préstamo</button>
        </div>
    </div>
</form>

@if (prestamoCargado)
{
    <form asp-action="Devolver" method="post">
        <input type="hidden" asp-for="IdPrestamo" />
        <input type="hidden" asp-for="Prestamo" />
        <input type="hidden" asp-for="Cliente" />
        <input type="hidden" asp-for="EmpleadoRegistro" />
        <input type="hidden" asp-for="Libros" />
        <input type="hidden" asp-for="FechaPrestamo" />
        <input type="hidden" asp-for="FechaEstimadaDevolucion" />
        <input type="hidden" asp-for="FechaDevolucion" />
        <input type="hidden" asp-for="EstaVencido" />
        <input type="hidden" asp-for="DiasVencido" />
        <input type="hidden" asp-for="YaDevuelto" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @if (Model.EstaVencido)
        {
            <div class="alert alert-warning">Este préstamo está vencido hace @Model.DiasVencido día@(Model.DiasVencido == 1 ? "" : "s"). Vencía el @Model.FechaEstimadaDevolucion.ToString("dd/MM/yyyy").</div>
        }

        @if (Model.YaDevuelto)
        {
            <div class="alert alert-info">Este préstamo no tiene libros pendientes de devolución.</div>
        }

        <dl class="row">
            <dt class="col-sm-3">Préstamo</dt>
            <dd class="col-sm-9">@Model.Prestamo</dd>
            <dt class="col-sm-3">Cliente</dt>
            <dd class="col-sm-9">@Model.Cliente</dd>
            <dt class="col-sm-3">Registrado por</dt>
            <dd class="col-sm-9">@Model.EmpleadoRegistro</dd>
            <dt class="col-sm-3">Libros pendientes</dt>
            <dd class="col-sm-9">@Model.Libros</dd>
            <dt class="col-sm-3">Fecha de creación</dt>
            <dd class="col-sm-9">@Model.FechaPrestamo.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Vence el</dt>
            <dd class="col-sm-9">@Model.FechaEstimadaDevolucion.ToString("dd/MM/yyyy")</dd>
        </dl>

        @if (!Model.YaDevuelto)
        {
            <button type="submit" class="btn btn-primary">Registrar devolución</button>
        }
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </form>
}
else
{
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
