@model DevolucionPrestamoViewModel

@{
    ViewData["Title"] = "Registrar devolucion";
}

<h1>Registrar devolucion</h1>

<form asp-action="Devolver">
    <input type="hidden" asp-for="IdItemPrestamo" />
    <input type="hidden" asp-for="Prestamo" />
    <input type="hidden" asp-for="Libro" />
    <input type="hidden" asp-for="FechaPrestamo" />
    <input type="hidden" asp-for="FechaEstimadaDevolucion" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <dl class="row">
        <dt class="col-sm-3">Prestamo</dt>
        <dd class="col-sm-9">@Model.Prestamo</dd>
        <dt class="col-sm-3">Libro</dt>
        <dd class="col-sm-9">@Model.Libro</dd>
        <dt class="col-sm-3">Fecha de prestamo</dt>
        <dd class="col-sm-9">@Model.FechaPrestamo.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-3">Fecha estimada</dt>
        <dd class="col-sm-9">@Model.FechaEstimadaDevolucion.ToString("dd/MM/yyyy")</dd>
    </dl>

    <div class="mb-3">
        <label asp-for="FechaDevolucion" class="form-label"></label>
        <input asp-for="FechaDevolucion" class="form-control" />
        <span asp-validation-for="FechaDevolucion" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Registrar devolucion</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
