@model Prestamo

@{
    ViewData["Title"] = "Dar de baja préstamo";
    var itemsPendientes = Model.ItemsPrestamo.Where(i => i.FechaDevolucion is null).ToList();
}

<h1>Dar de baja préstamo</h1>

<div class="alert alert-warning">Esta acción eliminará el préstamo y restituirá el stock pendiente asociado.</div>

<dl class="row">
    <dt class="col-sm-3">Cliente</dt>
    <dd class="col-sm-9">@Model.Cliente.NombreCompleto</dd>
    <dt class="col-sm-3">Registrado por</dt>
    <dd class="col-sm-9">@Model.EmpleadoRegistro.NombreCompleto</dd>
    <dt class="col-sm-3">Fecha de creación</dt>
    <dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Vence el</dt>
    <dd class="col-sm-9">@Model.FechaEstimadaDevolucion.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Libros pendientes</dt>
    <dd class="col-sm-9">@itemsPendientes.Count</dd>
</dl>

@if (itemsPendientes.Count > 0)
{
    <table class="table table-sm">
        <thead><tr><th>ISBN</th><th>Libro</th></tr></thead>
        <tbody>
@foreach (var item in itemsPendientes)
{
            <tr><td>@item.Libro.ISBN</td><td>@item.Libro.Titulo</td></tr>
}
        </tbody>
    </table>
}

<form asp-action="Baja" method="post">
    <input type="hidden" name="id" value="@Model.IdPrestamo" />
    <button type="submit" class="btn btn-danger">Confirmar baja</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>
