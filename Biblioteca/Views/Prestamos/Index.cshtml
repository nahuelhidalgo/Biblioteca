@model IEnumerable<Prestamo>

@{
    ViewData["Title"] = "Préstamos";
    var vista = ViewBag.Vista as string;
    var orden = ViewBag.Orden as string ?? "fecha";
    var idCliente = ViewBag.IdCliente as int?;
    var mostrarFinalizados = ViewBag.MostrarFinalizados is true;
    var mostrandoVencidos = string.Equals(vista, "vencidos", StringComparison.OrdinalIgnoreCase);
    var mostrandoProximosVencimientos = string.Equals(vista, "proximos-vencimientos", StringComparison.OrdinalIgnoreCase);
    var ordenandoPorFecha = string.Equals(orden, "fecha", StringComparison.OrdinalIgnoreCase);
    var esAdministrador = string.Equals(Context.Session.GetString(SesionKeys.Rol), RolesSistema.Administrador, StringComparison.OrdinalIgnoreCase);
    var siguienteVistaProximosVencimientos = mostrandoProximosVencimientos ? null : "proximos-vencimientos";
    var siguienteVistaVencidos = mostrandoVencidos ? null : "vencidos";
    var siguienteOrden = ordenandoPorFecha ? "vencimiento" : "fecha";
    var textoBotonOrden = ordenandoPorFecha
        ? "Ordenar por vencimiento cercano"
        : "Ordenar por fecha de creación";
}

@functions {
    private static int DiasParaVencimiento(Prestamo prestamo)
    {
        return (prestamo.FechaEstimadaDevolucion.Date - DateTime.Now.Date).Days;
    }

    private static int DiasDeAtraso(Prestamo prestamo)
    {
        if (prestamo.FechaDevolucion is null)
        {
            return Math.Max(0, (DateTime.Now.Date - prestamo.FechaEstimadaDevolucion.Date).Days);
        }

        return prestamo.ItemsPrestamo.Count == 0
            ? 0
            : prestamo.ItemsPrestamo.Max(i => i.DiasRetraso);
    }
}

<h1>Préstamos</h1>

<form asp-action="Index" method="get" class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <input type="hidden" name="vista" value="@vista" />
    <input type="hidden" name="orden" value="@orden" />
    <input type="hidden" name="mostrarFinalizados" value="@mostrarFinalizados.ToString().ToLowerInvariant()" />
    <label class="form-label mb-0" for="idCliente">Cliente:</label>
    <select id="idCliente" name="idCliente" class="form-select w-auto" asp-items="ViewBag.Clientes">
        <option value="">Todos los clientes</option>
    </select>
    <button type="submit" class="btn btn-outline-primary">Filtrar</button>
    @if (idCliente.HasValue)
    {
        <a asp-action="Index"
           asp-route-vista="@vista"
           asp-route-orden="@orden"
           asp-route-mostrarFinalizados="@mostrarFinalizados"
           class="btn btn-outline-secondary">Quitar filtro</a>
    }
</form>

<p class="d-flex flex-wrap gap-2">
    <a asp-action="Create" class="btn btn-primary">Nuevo préstamo</a>
    <a asp-action="Devolver" class="btn btn-outline-primary">Registrar devolución</a>
    <a asp-action="Index" asp-route-vista="@vista" asp-route-orden="@siguienteOrden"
       asp-route-idCliente="@idCliente" asp-route-mostrarFinalizados="@mostrarFinalizados"
       class="btn btn-outline-secondary">@textoBotonOrden</a>
    <a asp-action="Index" asp-route-vista="@siguienteVistaProximosVencimientos" asp-route-orden="@orden"
       asp-route-idCliente="@idCliente" asp-route-mostrarFinalizados="@mostrarFinalizados"
       class="btn @(mostrandoProximosVencimientos ? "btn-info" : "btn-outline-info")">Filtrar próximos 7 días</a>
    <a asp-action="Index" asp-route-vista="@siguienteVistaVencidos" asp-route-orden="@orden"
       asp-route-idCliente="@idCliente" asp-route-mostrarFinalizados="@mostrarFinalizados"
       class="btn @(mostrandoVencidos ? "btn-warning" : "btn-outline-warning")">Filtrar por vencidos</a>
    <a asp-action="Index" asp-route-vista="@vista" asp-route-orden="@orden"
       asp-route-idCliente="@idCliente" asp-route-mostrarFinalizados="@(!mostrarFinalizados)"
       class="btn @(mostrarFinalizados ? "btn-danger" : "btn-outline-danger")">@(mostrarFinalizados ? "Ocultar finalizados" : "Ver finalizados")</a>
</p>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Cliente</th>
            <th>Fecha de creación</th>
            <th>Fecha de vencimiento</th>
            <th>Vence En</th>
            <th>Fecha de devolución</th>
            <th>Días de atraso</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
    var diasParaVencer = DiasParaVencimiento(item);
    var diasAtraso = DiasDeAtraso(item);
    var estaPendiente = item.FechaDevolucion is null;
        <tr>
            <td>@item.IdPrestamo</td>
            <td>@item.Cliente.NombreCompleto</td>
            <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
            <td>@item.FechaEstimadaDevolucion.ToString("dd/MM/yyyy")</td>
            <td>
                @if (estaPendiente)
                {
                    if (diasParaVencer < 0)
                    {
                        <span class="badge bg-warning text-dark">Vencido</span>
                    }
                    else if (diasParaVencer == 0)
                    {
                        <span class="text-warning">Vence hoy</span>
                    }
                    else
                    {
                        <span>@diasParaVencer día@(diasParaVencer == 1 ? "" : "s")</span>
                    }
                }
            </td>
            <td>@(item.FechaDevolucion?.ToString("dd/MM/yyyy") ?? string.Empty)</td>
            <td>@(diasAtraso > 0 ? diasAtraso.ToString() : string.Empty)</td>
            <td>@item.Estado</td>
            <td class="text-end">
                <div class="table-actions">
                    @if (estaPendiente)
                    {
                        <a asp-action="Devolver" asp-route-id="@item.IdPrestamo" class="btn btn-sm btn-outline-success">Registrar devolución</a>
                    }
                    <a asp-action="Details" asp-route-id="@item.IdPrestamo" class="btn btn-sm btn-outline-secondary">Detalle</a>
                    @if (esAdministrador)
                    {
                        <a asp-action="Baja" asp-route-id="@item.IdPrestamo" class="btn btn-sm btn-outline-danger">Dar de baja</a>
                    }
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
