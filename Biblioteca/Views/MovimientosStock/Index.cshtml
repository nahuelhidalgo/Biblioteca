@model IEnumerable<MovimientoStock>

@{
    ViewData["Title"] = "Movimientos";
}

<h1>Movimientos</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>ISBN</th>
            <th>Libro</th>
            <th>Tipo de movimiento</th>
            <th>Cantidad</th>
            <th>Motivo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@item.Libro.ISBN</td>
            <td>@item.Libro.Titulo</td>
            <td>@item.TipoMovimiento</td>
            <td>@item.Cantidad</td>
            <td>@item.Motivo</td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@item.IdMovimientoStock">Detalle</a>
            </td>
        </tr>
}
    </tbody>
</table>
