@model IEnumerable<Libro>

@{
    ViewData["Title"] = "Libros";
    var esAdministrador = string.Equals(Context.Session.GetString(SesionKeys.Rol), RolesSistema.Administrador, StringComparison.OrdinalIgnoreCase);
}

<h1>Libros</h1>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-8">
        <input name="busqueda" value="@ViewBag.Busqueda" class="form-control" placeholder="Buscar por título, autor, categoría o ISBN" />
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        @if (esAdministrador)
        {
            <a asp-action="Create" class="btn btn-primary">Crear libro</a>
        }
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ISBN</th>
            <th>Título</th>
            <th>Autor</th>
            <th>Categoría</th>
            <th>Editorial</th>
            <th>Stock</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.ISBN</td>
            <td>@item.Titulo</td>
            <td>@item.Autor.Apellido, @item.Autor.Nombre</td>
            <td>@item.Categoria.Nombre</td>
            <td>@item.Editorial.Nombre</td>
            <td>@item.StockDisponible / @item.StockTotal</td>
            <td>
                <span class="badge @(item.Activo ? "text-bg-success" : "text-bg-secondary")">
                    @(item.Activo ? "Activo" : "Inactivo")
                </span>
            </td>
            <td class="text-end">
                <div class="table-actions">
                    @if (esAdministrador)
                    {
                        <a asp-action="Edit" asp-route-id="@item.IdLibro" class="btn btn-sm btn-outline-primary">Editar</a>
                    }
                    <a asp-action="Details" asp-route-id="@item.IdLibro" class="btn btn-sm btn-outline-secondary">Detalle</a>
                    @if (esAdministrador)
                    {
                        if (item.Activo)
                        {
                            <a asp-action="Delete" asp-route-id="@item.IdLibro" class="btn btn-sm btn-outline-danger">Baja</a>
                        }
                        else
                        {
                            <form asp-action="Activar" asp-route-id="@item.IdLibro" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-success">Activar</button>
                            </form>
                        }
                    }
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
