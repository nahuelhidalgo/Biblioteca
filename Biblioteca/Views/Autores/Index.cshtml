@model IEnumerable<Autor>

@{
    ViewData["Title"] = "Autores";
}

<h1>Autores</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear autor</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Nacionalidad</th>
            <th>Activo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Nombre</td>
            <td>@item.Apellido</td>
            <td>@item.Nacionalidad</td>
            <td>@(item.Activo ? "Si" : "No")</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@item.IdAutor">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.IdAutor">Detalle</a> |
                <a asp-action="Delete" asp-route-id="@item.IdAutor">Baja</a>
            </td>
        </tr>
}
    </tbody>
</table>
