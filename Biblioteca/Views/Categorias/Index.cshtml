@model IEnumerable<Categoria>

@{
    ViewData["Title"] = "Categorias";
    var esAdministrador = string.Equals(Context.Session.GetString(SesionKeys.Rol), RolesSistema.Administrador, StringComparison.OrdinalIgnoreCase);
}

<h1>Categorias</h1>

@if (esAdministrador)
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Crear categoria</a>
    </p>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripcion</th>
            <th>Activo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Nombre</td>
            <td>@item.Descripcion</td>
            <td>@(item.Activo ? "Si" : "No")</td>
            <td class="text-end">
                @if (esAdministrador)
                {
                    <a asp-action="Edit" asp-route-id="@item.IdCategoria">Editar</a>
                    <span>|</span>
                    <a asp-action="Delete" asp-route-id="@item.IdCategoria">Baja</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
