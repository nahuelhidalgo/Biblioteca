@model Cliente

@{
    ViewData["Title"] = "Dar de baja cliente";
    var prestamosActivos = Model.Prestamos.Count(p => p.FechaDevolucion is null);
}

<h1>Dar de baja cliente</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@if (Model.Activo)
{
    <p>Para dar de baja un cliente, no debe tener préstamos activos.</p>
    <p class="text-muted">La baja marca al cliente como inactivo para conservar su historial, pero no podrá seleccionarse para nuevos préstamos.</p>

    if (prestamosActivos > 0)
    {
        <div class="alert alert-warning">
            Este cliente tiene @prestamosActivos préstamo@(prestamosActivos == 1 ? "" : "s") activo@(prestamosActivos == 1 ? "" : "s").
            Si intenta darlo de baja, la operación será rechazada hasta que esos préstamos se cierren.
        </div>
    }
}
else
{
    <div class="alert alert-info">Este cliente ya se encuentra inactivo.</div>
}

<dl class="row">
    <dt class="col-sm-3">Cliente</dt>
    <dd class="col-sm-9">@Model.NombreCompleto</dd>
    <dt class="col-sm-3">DNI</dt>
    <dd class="col-sm-9">@Model.DNI</dd>
    <dt class="col-sm-3">Préstamos activos</dt>
    <dd class="col-sm-9">@prestamosActivos</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="IdPersona" />
    @if (Model.Activo)
    {
        <button type="submit" class="btn btn-danger">Dar de baja</button>
    }
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>
