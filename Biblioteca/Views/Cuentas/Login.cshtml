@model LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesion";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1>Iniciar sesion</h1>

        <form asp-action="Login" method="post" class="mt-3">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Cuenta" class="form-label"></label>
                <input asp-for="Cuenta" class="form-control" autofocus />
                <span asp-validation-for="Cuenta" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Ingresar</button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
